# Copy to .env.local and fill in. Arms with missing credentials are skipped
# automatically, so you can run a partial bakeoff with just one provider.

# Required. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional. Azure lost the Phase 0 comparison (see spike/FINDINGS.md §7, §9) and
# nothing in the app uses it, but the provider implementations are kept so the
# comparison can be re-run when models change. Leave blank to skip those arms.
# Region is the short form — eastus — not the endpoint URL the portal shows
# beside the key.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- Neon (serverless Postgres) ---
# Pooled connection (PgBouncer) — used by the running app. Note the "-pooler" host.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/persian-practice?sslmode=require&pgbouncer=true"
# Direct connection — used by `drizzle-kit` migrations. Same host WITHOUT "-pooler".
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/persian-practice?sslmode=require"

