# Copy to .env.local and fill in. Arms with missing credentials are skipped
# automatically, so you can run a partial bakeoff with just one provider.

# Required. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional. Azure lost the Phase 0 comparison (see spike/FINDINGS.md §7, §9) and
# nothing in the app uses it, but the provider implementations are kept so the
# comparison can be re-run when models change. Leave blank to skip those arms.
# Region is the short form — eastus — not the endpoint URL the portal shows
# beside the key.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- Neon (serverless Postgres) ---
# Pooled connection (PgBouncer) — used by the running app. Note the "-pooler" host.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/persian-practice?sslmode=require&pgbouncer=true"
# Direct connection — used by `drizzle-kit` migrations. Same host WITHOUT "-pooler".
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/persian-practice?sslmode=require"

# --- Vercel Blob (lesson audio) ---
# Synthesised mp3s are stored here. Create a *private* Blob store in the Vercel
# dashboard (Storage → Create → Blob) and copy its read-write token. On Vercel
# the variable is set automatically once the store is connected to the project.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# --- Auth.js (NextAuth) ---
# Generate with: npx auth secret
AUTH_SECRET="replace-me"

# Email magic-link sign-in via Resend — https://resend.com. In development
# these can be omitted: the sign-in link is logged to the server console and a
# dev-credentials form is shown, so no email infra is needed. That same dev
# sign-in form is also enabled on Vercel *preview* deploys (keyed off
# VERCEL_ENV), where the magic-link email is unreliable — it stays OFF only in
# real production, where AUTH_RESEND_KEY is required (sign-in throws without it).
#   AUTH_RESEND_KEY: a Resend API key (starts with "re_").
#   EMAIL_FROM:      the From: address. "onboarding@resend.dev" works to your
#                    own account email without domain verification.
AUTH_RESEND_KEY="re_..."
EMAIL_FROM="Persian Practice <onboarding@resend.dev>"

# Dev sign-in allowlist — comma-separated emails permitted to use the dev
# credentials form. When set, ONLY these emails can dev-sign-in. When unset,
# dev sign-in is open locally/CI but DENIED on Vercel previews. Leave unset
# locally.
DEV_SIGNIN_ALLOWED_EMAILS="you@example.com"

# Who may change what every learner shares: "Something wrong?" under curated
# words and sentences, and the recordings to check on /review.
# Comma-separated emails. Unset: anyone signed in locally, nobody in production.
AUDIO_REVIEWER_EMAILS="you@example.com"

# --- Background jobs (new sentences, audio for added words) ---
# The app queues this work and nudges its own worker route, /api/jobs/run,
# which does it within a time limit of its own. Both the nudge and the daily
# Vercel Cron sweep (vercel.json) send this as `Authorization: Bearer …`;
# Vercel Cron does so by itself once a variable with exactly this name exists.
# Generate with: openssl rand -hex 32
# Unset: there is no worker to hand over to, so a little of the work is done
# inside the request that asked for it and the rest waits. Fine locally.
CRON_SECRET=""
# Where the app can reach itself, e.g. "https://persian.example.com". Only
# needed off Vercel, or where the production domain Vercel reports is not the
# one to use; on Vercel it is worked out from the deployment.
APP_URL=""

BLOB_STORE_ID=""
BLOB_READ_WRITE_TOKEN=""