{
  "name": "persian-practice",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "drizzle-kit migrate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed-content.ts",
    "db:audio": "tsx scripts/generate-audio.ts",
    "db:sentences": "tsx scripts/generate-sentences.ts",
    "db:expand": "tsx scripts/expand.ts",
    "spike:check": "tsx spike/check-credentials.ts",
    "spike:tts": "tsx spike/tts-bakeoff.ts",
    "spike:report": "tsx spike/tts-bakeoff.ts --report-only",
    "spike:stt": "tsx spike/stt-probe.ts",
    "spike:pron": "tsx spike/pronunciation-probe.ts",
    "spike:homograph": "tsx spike/homograph-probe.ts",
    "spike:instruct": "tsx spike/openai-instruction-probe.ts",
    "spike:accent": "tsx spike/accent-probe.ts",
    "spike:chatbench": "tsx spike/chat-bench.ts",
    "spike:ttslatency": "tsx spike/tts-latency.ts",
    "spike:conversation": "tsx spike/conversation-probe.ts",
    "spike:listener": "tsx spike/listener-probe.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.2",
    "@headlessui/react": "^2.2.10",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.8.1",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.0",
    "next-auth": "^5.0.0-beta.31",
    "openai": "^7.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.11",
    "typescript": "^5"
  }
}
